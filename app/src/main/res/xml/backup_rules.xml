<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup automático en Android 11 o anterior. El autenticador del franco queda afuera: su secreto
   está cifrado con una clave del Keystore que no viaja con el backup.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/holiday_auth.preferences_pb" />
</full-backup-content>
