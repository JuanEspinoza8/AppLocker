<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup y transferencia entre teléfonos en Android 12 o superior. El autenticador del franco
   queda afuera: su secreto está cifrado con una clave del Keystore que no viaja con los datos.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/holiday_auth.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/holiday_auth.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
